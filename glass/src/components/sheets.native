<!-- The three sheets that make or keep a channel: mint an invitation, accept
     one, and back the site up — plus settings, where everything about this
     endpoint lives: its handle, its facts, its look, its language, the face
     Chinese is drawn in, its maintenance. The four characters are the whole
     point of the first two (ARCHITECTURE.md §8): both ends print them, two
     people read them to each other, and an invitation swapped in transit
     fails the comparison. So the code is the largest thing on the sheet.
     Every sentence is bound from `t`, so the two languages cannot drift.
     Long prose never shares a row with a fixed-width field: a row's flex does
     not shrink, so an over-long intrinsic width clips instead of wrapping. -->
<template name="endpoint-fact" args="name value">
  <column gap="2">
    <text size="sm" foreground="text_muted">{name}</text>
    <text><span mono="true">{value}</span></text>
  </column>
</template>

<!-- A fact whose value is a word, not a code: the body face draws it, so
     a Chinese word is not handed to the mono face that has no such glyph. -->
<template name="endpoint-word" args="name value">
  <column gap="2">
    <text size="sm" foreground="text_muted">{name}</text>
    <text>{value}</text>
  </column>
</template>

<template name="settings-face">
  <column gap="6">
    <text size="sm" foreground="text_muted" padding="4">{t.face_heading}</text>
    <card padding="14">
      <column gap="8">
        <text><span mono="true">{faceShown}</span></text>
        <if test="{face.wasRefused}">
          <alert text="{t.face_refused}" variant="destructive">
            <text wrap="true">{face.refusedText}</text>
          </alert>
        </if>
        <text size="sm" foreground="text_muted" wrap="true">{t.face_hint}</text>
        <text-field text="{face.pathText}" placeholder="C:\Windows\Fonts\simhei.ttf" on-input="face_path_edit" on-submit="try_face" label="{t.face_path}"/>
        <row gap="8" cross="center">
          <if test="{face.probing}"><spinner/><text size="sm" foreground="text_muted">{t.face_probing}</text></if>
          <spacer grow="1"/>
          <button size="sm" variant="secondary" icon="file-text" on-press="try_face" disabled="{not face.ready}">{t.use_this_face}</button>
        </row>
        <if test="{face.hasVerdict}">
          <alert variant="destructive" text="{face.verdictText}"></alert>
        </if>
        <if test="{face.saved}">
          <alert text="{t.face_saved}"></alert>
        </if>
      </column>
    </card>
  </column>
</template>

<template name="settings-sheet">
  <sheet label="{t.settings}" on-dismiss="close_sheet">
    <column gap="14" padding="20" width="420" grow="1">
      <text size="heading">{t.settings}</text>
      <scroll grow="1">
        <column gap="14">
          <card padding="14">
            <column gap="8">
              <row gap="10" cross="center">
                <avatar size="sm">me</avatar>
                <text grow="1" size="sm" foreground="text_muted">{t.handle}</text>
                <button size="sm" variant="ghost" icon="copy" label="{t.copy_handle}" on-press="copy_handle"></button>
              </row>
              <text><span mono="true">{handleBlock}</span></text>
              <text size="sm" foreground="text_muted" wrap="true">{t.handle_hint}</text>
              <if test="{clipboardHeld}"><text size="sm" foreground="text_muted" wrap="true">{t.clipboard_note}</text></if>
            </column>
          </card>
          <card padding="14">
            <column gap="10">
              <use template="endpoint-fact" name="{t.site}" value="{siteShown}"/>
              <use template="endpoint-fact" name="{t.sealed_by}" value="{sealShown}"/>
              <use template="endpoint-word" name="{t.route}" value="{routeShown}"/>
              <use template="endpoint-fact" name="{t.binary}" value="{binaryShown}"/>
            </column>
          </card>
          <column gap="6">
            <text size="sm" foreground="text_muted" padding="4">{t.look}</text>
            <toggle-group gap="2" label="{t.look}">
              <for each="lookRows" key="tag" as="l">
                <toggle-button size="sm" grow="1" selected="{l.tag == look}" on-toggle="set_look:{l.tag}">{l.label}</toggle-button>
              </for>
            </toggle-group>
          </column>
          <column gap="6">
            <text size="sm" foreground="text_muted" padding="4">{t.language}</text>
            <toggle-group gap="2" label="{t.language}">
              <for each="languageRows" key="tag" as="l">
                <toggle-button size="sm" grow="1" selected="{l.tag == language}" on-toggle="set_language:{l.tag}">{l.label}</toggle-button>
              </for>
            </toggle-group>
            <if test="{not has_cjk}"><text size="sm" foreground="text_muted" wrap="true">{t.language_hint}</text></if>
          </column>
          <use template="settings-face"/>
          <column gap="6">
            <text size="sm" foreground="text_muted" padding="4">{t.maintenance}</text>
            <button variant="outline" icon="wrench" on-press="show_doctor" disabled="{isBusy}">{t.measure_a_host}</button>
            <button variant="outline" icon="save" on-press="show_backup" disabled="{isBusy}">{t.back_up_site}</button>
            <button variant="outline" icon="refresh-cw" on-press="refresh" disabled="{isBusy}">{t.refresh}</button>
          </column>
          <text size="sm" foreground="text_muted" wrap="true">{t.import_hint}</text>
        </column>
      </scroll>
      <row main="end"><button variant="ghost" on-press="close_sheet">{t.close}</button></row>
    </column>
  </sheet>
</template>
<template name="check-card">
  <card padding="20">
    <column gap="10" cross="center">
      <text size="sm" foreground="text_muted" wrap="true" text-alignment="center">{t.read_these}</text>
      <text size="display" label="{t.check_code}"><span mono="true">{checkSpaced}</span></text>
      <row gap="8" cross="center">
        <badge variant="outline">{checkFor}</badge>
        <button size="sm" variant="ghost" icon="copy" on-press="copy_check">{t.copy}</button>
      </row>
    </column>
  </card>
</template>

<template name="invite-form">
  <column gap="10">
    <text-field text="{invite.nameText}" placeholder="{t.name_placeholder}" on-input="invite_name_edit" on-submit="mint" label="{t.name}" autofocus="true"/>
    <text-field text="{invite.waypointText}" placeholder="{t.waypoint_placeholder}" on-input="invite_waypoint_edit" on-submit="mint" label="{t.waypoint}"/>
    <text-field text="{invite.everyText}" placeholder="{t.every_placeholder}" on-input="invite_every_edit" on-submit="mint" label="{t.slot_period}"/>
    <text size="sm" foreground="text_muted" wrap="true">{t.period_hint}</text>
    <switch checked="{invite.room}" on-toggle="toggle_invite_room">{t.room_switch}</switch>
    <if test="{invite.room}">
      <text size="sm" foreground="text_muted" wrap="true">{t.room_hint}</text>
    </if>
    <else>
      <switch checked="{invite.release}" on-toggle="toggle_invite_release">{t.release_switch}</switch>
      <if test="{invite.release}">
        <text size="sm" foreground="text_muted" wrap="true">{t.release_hint}</text>
      </if>
    </else>
    <row gap="8" main="end">
      <button variant="ghost" on-press="close_sheet">{t.cancel}</button>
      <button variant="primary" on-press="mint" disabled="{isBusy}">{t.mint}</button>
    </row>
  </column>
</template>

<template name="invite-handover">
  <column gap="12">
    <card padding="14">
      <column gap="8">
        <text size="sm" foreground="text_muted" wrap="true">{t.invitation_hint}</text>
        <text><span mono="true">{invite.lineText}</span></text>
        <button size="sm" variant="secondary" icon="copy" on-press="copy_invite">{t.copy_invitation}</button>
        <if test="{clipboardHeld}"><text size="sm" foreground="text_muted" wrap="true">{t.clipboard_note}</text></if>
      </column>
    </card>
    <use template="check-card"/>
    <button variant="primary" on-press="close_sheet">{t.done}</button>
  </column>
</template>

<template name="invite-sheet">
  <sheet label="{t.new_invitation}" on-dismiss="close_sheet">
    <column gap="14" padding="20" width="420">
      <text size="heading">{t.new_invitation}</text>
      <if test="{invite.minted}"><use template="invite-handover"/></if>
      <else><use template="invite-form"/></else>
    </column>
  </sheet>
</template>

<template name="join-sheet">
  <sheet label="{t.accept_invitation}" on-dismiss="close_sheet">
    <column gap="14" padding="20" width="460">
      <text size="heading">{t.accept_invitation}</text>
      <if test="{hasCheck}">
        <column gap="12">
          <use template="check-card"/>
          <button variant="primary" on-press="close_sheet">{t.done}</button>
        </column>
      </if>
      <else>
        <column gap="10">
          <text-field text="{join.nameText}" placeholder="{t.name_placeholder}" on-input="join_name_edit" on-submit="accept" label="{t.name}" autofocus="true"/>
          <textarea text="{join.invitationText}" placeholder="{t.paste_invitation}" on-input="join_text_edit" label="{t.invitation}" height="120"/>
          <text size="sm" foreground="text_muted" wrap="true">{t.stdin_hint}</text>
          <switch checked="{join.room}" on-toggle="toggle_join_room">{t.join_room_switch}</switch>
          <if test="{join.room}"><else>
            <switch checked="{join.release}" on-toggle="toggle_join_release">{t.release_switch}</switch>
          </else></if>
          <row gap="8" main="end">
            <button variant="ghost" on-press="close_sheet">{t.cancel}</button>
            <button variant="primary" on-press="accept" disabled="{isBusy}">{t.join}</button>
          </row>
        </column>
      </else>
    </column>
  </sheet>
</template>

<template name="backup-sheet">
  <sheet label="{t.backup}" on-dismiss="close_sheet">
    <column gap="14" padding="20" width="460">
      <text size="heading">{t.backup}</text>
      <if test="{backup.hasRecovery}">
        <column gap="12">
          <card padding="20">
            <column gap="10" cross="center">
              <text size="sm" foreground="text_muted" wrap="true" text-alignment="center">{t.recovery_hint}</text>
              <text size="heading" label="{t.recovery_key}"><span mono="true">{backup.recoveryKey}</span></text>
              <button size="sm" variant="secondary" icon="copy" on-press="copy_recovery">{t.copy_key}</button>
              <if test="{clipboardHeld}"><text size="sm" foreground="text_muted" wrap="true">{t.clipboard_note}</text></if>
            </column>
          </card>
          <if test="{backup.written}">
            <alert text="{t.archive_written}">
              <text wrap="true">{backup.pathText}</text>
            </alert>
          </if>
          <else>
            <row gap="8" cross="center"><spinner/><text size="sm" foreground="text_muted">{t.writing_archive}</text></row>
          </else>
          <text size="sm" foreground="text_muted" wrap="true">{t.restore_hint}</text>
          <button variant="primary" on-press="close_sheet">{t.done}</button>
        </column>
      </if>
      <else>
        <column gap="10">
          <text wrap="true">{t.export_body}</text>
          <text size="sm" foreground="text_muted" wrap="true">{t.export_hint}</text>
          <row gap="8" main="end">
            <button variant="ghost" on-press="close_sheet">{t.cancel}</button>
            <button variant="primary" icon="save" on-press="export_now" disabled="{isBusy}">{t.export_}</button>
          </row>
        </column>
      </else>
    </column>
  </sheet>
</template>
