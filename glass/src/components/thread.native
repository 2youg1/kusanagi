<!-- The open conversation, inside the plate: a header, the banners a
     channel earns, the two streams interleaved by what each segment
     acknowledged, a composer, and the status line. A run of segments from
     one speaker sits 8 apart; a change of speaker opens a wider gap. Every
     byte a peer wrote sits inside a bubble and nowhere else — the bubble is
     this window's fence. -->
<template name="thread-header">
  <row gap="14" cross="center" padding="20">
    <avatar>{currentInitials}</avatar>
    <column grow="1" gap="2">
      <text size="heading">{currentName}</text>
      <text size="sm" foreground="text_muted"><span mono="true">{currentPeer}</span> · {currentCadence}</text>
    </column>
    <if test="{currentReleases}"><badge variant="outline">releases</badge></if>
    <if test="{isBusy}"><spinner/></if>
    <button size="sm" variant="ghost" icon="wrench" label="Measure this host" on-press="show_doctor" disabled="{isBusy}"></button>
    <button size="sm" variant="ghost" icon="trash" label="Forget this channel" on-press="show_forget" disabled="{isBusy}"></button>
  </row>
</template>

<template name="thread-banners">
  <column gap="8">
    <if test="{currentReleases}">
      <alert text="This site is the only copy of this conversation">
        <column gap="8" cross="start">
          <text wrap="true">Each drop is deleted once they have read it, and its key is burned. Keep a backup, or a lost disk is a lost conversation.</text>
          <button size="sm" variant="secondary" icon="save" on-press="show_backup">Back up now</button>
        </column>
      </alert>
    </if>
    <if test="{waitingForPeer}">
      <alert text="Waiting for them to accept">
        <text wrap="true">Nobody has joined this channel yet. Hand over the invitation line and read the four characters to each other; the first read after they join learns who they are.</text>
      </alert>
    </if>
    <if test="{currentVoid}">
      <alert text="This channel no longer permits anything" variant="destructive">
        <text wrap="true">{currentRefusal}</text>
      </alert>
    </if>
  </column>
</template>

<template name="thread-bubbles">
  <scroll grow="1" label="Messages">
    <column gap="8" padding="4">
      <for each="thread" key="key" as="b">
        <if test="{b.turn}"><spacer height="16"/></if>
        <if test="{b.mine}">
          <row main="end">
            <bubble variant="primary" label="you">
              <column gap="4">
                <text wrap="true">{b.text}</text>
                <if test="{b.cut}"><text size="sm">… cut to fit this window</text></if>
              </column>
            </bubble>
          </row>
        </if>
        <else>
          <row main="start">
            <bubble label="them">
              <column gap="4">
                <if test="{b.is_hex}"><text size="sm" foreground="text_muted">bytes that are not text, as hex</text></if>
                <text wrap="true">{b.text}</text>
                <if test="{b.cut}"><text size="sm" foreground="text_muted">… cut to fit this window</text></if>
              </column>
            </bubble>
          </row>
        </else>
      </for>
      <else>
        <column main="center" cross="center" grow="1" gap="6" padding="48">
          <text size="heading" foreground="text_muted">Nothing here yet</text>
          <text foreground="text_muted" wrap="true" text-alignment="center">What you send lands at an address only the two of you can derive.</text>
        </column>
      </else>
    </column>
  </scroll>
</template>

<template name="thread-composer">
  <input-group label="Message">
    <textarea text="{draftText}" placeholder="Write something…" on-input="draft_edit" on-submit="send" submit-on-enter="true" autofocus="true" label="Message" disabled="{composerDisabled}" height="64"/>
    <input-group-actions gap="6">
      <text size="sm" foreground="text_muted"><span mono="true">{theirHeight}</span> verified of theirs · <span mono="true">{myHeight}</span> of yours</text>
      <spacer grow="1"/>
      <button variant="primary" size="sm" icon="send" on-press="send" disabled="{sendDisabled}">Send</button>
    </input-group-actions>
  </input-group>
</template>

<template name="status-line">
  <column>
  <if test="{hasStatus}">
    <if test="{statusIsError}">
      <alert text="{statusCode}" variant="destructive">
        <row gap="8" cross="center">
          <column grow="1" gap="2">
            <text wrap="true">{statusText}</text>
            <text size="sm" foreground="text_muted" wrap="true">try: {statusRecover}</text>
          </column>
          <button size="sm" variant="ghost" icon="x" label="Dismiss" on-press="dismiss_status"></button>
        </row>
      </alert>
    </if>
    <else>
      <row gap="8" cross="center" padding="4">
        <icon name="info" foreground="text_muted" label="note"/>
        <text grow="1" size="sm" foreground="text_muted">{statusText}</text>
        <button size="sm" variant="ghost" icon="x" label="Dismiss" on-press="dismiss_status"></button>
      </row>
    </else>
  </if>
  </column>
</template>

<template name="thread-pane">
  <column grow="1">
    <use template="thread-header"/>
    <separator/>
    <column grow="1" padding="24" gap="12">
      <use template="thread-banners"/>
      <use template="thread-bubbles"/>
      <use template="thread-composer"/>
      <use template="status-line"/>
    </column>
  </column>
</template>
