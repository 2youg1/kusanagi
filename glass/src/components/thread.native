<!-- The open conversation, inside the plate: a header, the banners a
     channel earns, the two streams interleaved by what each segment
     acknowledged, a composer, and the status line. A run of segments from
     one speaker sits 8 apart; a change of speaker opens a wider gap. Every
     byte a peer wrote sits inside a bubble and nowhere else — the bubble is
     this window's fence. -->
<template name="thread-header">
  <row gap="14" cross="center" padding="20">
    <avatar>{currentInitials}</avatar>
    <column grow="1" gap="2">
      <text size="heading">{currentName}</text>
      <if test="{currentSlotted}">
        <text size="sm" foreground="text_muted"><span mono="true">{currentPeer}</span> · {currentCadence}</text>
      </if>
      <else><text size="sm" foreground="text_muted"><span mono="true">{currentPeer}</span></text></else>
    </column>
    <if test="{currentReleases}"><badge variant="outline">{t.releases}</badge></if>
    <if test="{isBusy}"><spinner/></if>
    <button size="sm" variant="ghost" icon="wrench" label="{t.measure_this_host}" on-press="show_doctor" disabled="{isBusy}"></button>
    <button size="sm" variant="ghost" icon="trash" label="{t.forget_channel}" on-press="show_forget" disabled="{isBusy}"></button>
  </row>
</template>

<template name="thread-banners">
  <column gap="8">
    <if test="{currentReleases}">
      <alert text="{t.only_copy_title}">
        <column gap="8" cross="start">
          <text wrap="true">{t.only_copy_body}</text>
          <button size="sm" variant="secondary" icon="save" on-press="show_backup">{t.back_up_now}</button>
        </column>
      </alert>
    </if>
    <if test="{waitingForPeer}">
      <alert text="{t.waiting_title}">
        <text wrap="true">{t.waiting_body}</text>
      </alert>
    </if>
    <if test="{currentVoid}">
      <alert text="{t.void_hint}" variant="destructive">
        <text wrap="true">{currentRefusal}</text>
      </alert>
    </if>
  </column>
</template>

<template name="thread-bubbles">
  <scroll grow="1" label="{t.messages}">
    <column gap="8" padding="4" grow="1" main="end">
      <spacer height="4"/>
      <for each="thread" key="key" as="b">
        <if test="{b.turn}"><spacer height="16"/></if>
        <if test="{b.mine}">
          <row main="end">
            <bubble variant="primary" label="{t.you}" padding="12">
              <column gap="4">
                <markdown source="{b.text}"/>
                <if test="{b.cut}"><text size="sm">{t.cut_to_fit}</text></if>
              </column>
            </bubble>
          </row>
        </if>
        <else>
          <row main="start">
            <bubble label="{t.them}" padding="12">
              <column gap="4">
                <if test="{b.is_hex}">
                  <text size="sm" foreground="text_muted">{t.not_text}</text>
                  <text><span mono="true">{b.text}</span></text>
                </if>
                <else><markdown source="{b.text}"/></else>
                <if test="{b.cut}"><text size="sm" foreground="text_muted">{t.cut_to_fit}</text></if>
              </column>
            </bubble>
          </row>
        </else>
      </for>
      <else>
        <column main="center" cross="center" grow="1" gap="6" padding="48">
          <text size="heading" foreground="text_muted">{t.nothing_here}</text>
          <text foreground="text_muted" wrap="true" text-alignment="center">{t.nothing_here_body}</text>
        </column>
      </else>
    </column>
  </scroll>
</template>

<template name="thread-composer">
  <input-group label="{t.message}">
    <textarea text="{draftText}" placeholder="{t.write_something}" on-input="draft_edit" on-submit="send" submit-on-enter="true" autofocus="true" label="{t.message}" disabled="{composerDisabled}" height="64"/>
    <input-group-actions gap="6">
      <text size="sm" foreground="text_muted">{tally}</text>
      <spacer grow="1"/>
      <button variant="primary" size="sm" icon="send" on-press="send" disabled="{sendDisabled}">{t.send}</button>
    </input-group-actions>
  </input-group>
</template>

<template name="status-line">
  <column>
  <if test="{hasStatus}">
    <if test="{statusIsError}">
      <alert text="{statusCode}" variant="destructive">
        <row gap="8" cross="center">
          <column grow="1" gap="2">
            <text wrap="true">{statusText}</text>
            <text size="sm" foreground="text_muted" wrap="true">{t.try_prefix} {statusRecover}</text>
          </column>
          <button size="sm" variant="ghost" icon="x" label="{t.dismiss}" on-press="dismiss_status"></button>
        </row>
      </alert>
    </if>
    <else>
      <row gap="8" cross="center" padding="4">
        <icon name="info" foreground="text_muted" label="{t.note}"/>
        <text grow="1" size="sm" foreground="text_muted">{statusText}</text>
        <button size="sm" variant="ghost" icon="x" label="{t.dismiss}" on-press="dismiss_status"></button>
      </row>
    </else>
  </if>
  </column>
</template>

<template name="thread-pane">
  <column grow="1">
    <use template="thread-header"/>
    <separator/>
    <column grow="1" padding="24" gap="12">
      <use template="thread-banners"/>
      <use template="thread-bubbles"/>
      <use template="thread-composer"/>
      <use template="status-line"/>
    </column>
  </column>
</template>
