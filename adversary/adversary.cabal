cabal-version:   3.0
name:            kusanagi-adversary
version:         0.0.1
synopsis:        A counterexample hunter that attacks kusanagi through the door a user has
description:
  Out of the Rust workspace, out of the release, and out of `just check`. It
  drives the shipped binary with `--json`, asserts relations between traces, and
  delivers what it finds as a Rust regression test. See adversary-SPEC.md.

license:         MPL-2.0
author:          2youg1 and the kusanagi contributors
build-type:      Simple
extra-doc-files: adversary-SPEC.md

common strict
  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns
    -Wredundant-constraints -Wpartial-fields -Werror

library
  import:           strict
  hs-source-dirs:   src
  default-language: GHC2021
  exposed-modules:
    Kusanagi.Answer
    Kusanagi.Cairn
    Kusanagi.Custody
    Kusanagi.Discriminator
    Kusanagi.Door
    Kusanagi.Doorway
    Kusanagi.Automation
    Kusanagi.Forging
    Kusanagi.Glass
    Kusanagi.Ground
    Kusanagi.Insider
    Kusanagi.Journey
    Kusanagi.Room
    Kusanagi.Keyboard
    Kusanagi.Leakage
    Kusanagi.Listener
    Kusanagi.Lying
    Kusanagi.Model
    Kusanagi.Naming
    Kusanagi.Overheard
    Kusanagi.Port
    Kusanagi.Reach
    Kusanagi.Regression
    Kusanagi.Relay
    Kusanagi.Scanner
    Kusanagi.Service
    Kusanagi.Stage
    Kusanagi.Sweep
    Kusanagi.Tempo
    Kusanagi.Terminal
    Kusanagi.Twins
    Kusanagi.Veil

  build-depends:
    , aeson               >=2.1  && <2.3
    , base                >=4.17 && <5
    , bytestring          >=0.11
    , containers          >=0.6
    , directory           >=1.3
    , filepath            >=1.4
    , mtl                 >=2.2
    , network             >=3.1
    , process             >=1.6
    , QuickCheck          >=2.14
    , quickcheck-dynamic  >=4.0  && <5
    , temporary           >=1.3
    , text                >=2.0
    , vector              >=0.13

test-suite adversary
  import:           strict
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:    Surface
  hs-source-dirs:   test
  default-language: GHC2021

  -- Without `-threaded` the runtime has one capability, tasty asks it how many
  -- there are, and every property runs after the last one however many cores the
  -- machine has. Isolation is by construction here -- one temporary directory
  -- per world, one operating-system-assigned port per relay -- so the only thing
  -- that was serialising this suite was a missing flag.
  --
  -- `-N4` rather than `-N`: every property spawns the real binary, and sixteen of
  -- them at once measures the scheduler rather than the product. The timing
  -- experiment in `Kusanagi.Tempo` is the one that would notice.
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4"
  build-depends:
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , kusanagi-adversary
    , mtl
    , QuickCheck
    , quickcheck-dynamic
    , tasty               >=1.4
    , tasty-hunit         >=0.10
    , tasty-quickcheck    >=0.10
    , text
